<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.LocalInferencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid HorizontalAlignment="Stretch">
        <StackPanel Padding="24" Spacing="8" HorizontalAlignment="Stretch" MaxWidth="900">

            <TextBlock x:Uid="LocalInferencePage_PageTitle" x:Name="PageTitleText" Text="Local Inference"
                       AutomationProperties.AutomationId="LocalInferencePageMarker"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Uid="LocalInferencePage_PageDescription" x:Name="PageDescriptionText"
                       Text="Run a model on this machine with llama.cpp. Weights and the runtime are downloaded once and stay on your device."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Detected hardware -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="LocalInferencePage_HardwareHeader" Text="Detected hardware"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="HardwareSummaryText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="BackendSummaryText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <Button x:Name="RedetectButton" Click="OnRedetectClick"
                            AutomationProperties.LabeledBy="{Binding ElementName=RedetectButtonText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock x:Uid="LocalInferencePage_RedetectButtonText" x:Name="RedetectButtonText"
                                       Text="Re-detect hardware"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Model -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="LocalInferencePage_ModelHeader" Text="Model"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <ComboBox x:Uid="LocalInferencePage_ModelCombo" x:Name="ModelCombo"
                              SelectionChanged="OnModelChanged" Width="420"/>

                    <TextBlock x:Name="ModelFitText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <Border x:Name="LargeDownloadNotice"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock x:Name="LargeDownloadNoticeText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="DownloadButton" Click="OnDownloadClick"
                                AutomationProperties.LabeledBy="{Binding ElementName=DownloadButtonText}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                <TextBlock x:Uid="LocalInferencePage_DownloadButtonText" x:Name="DownloadButtonText"
                                           Text="Download model"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelDownloadButton" Click="OnCancelDownloadClick" Visibility="Collapsed"
                                AutomationProperties.LabeledBy="{Binding ElementName=CancelDownloadButtonText}">
                            <TextBlock x:Uid="LocalInferencePage_CancelDownloadButtonText" x:Name="CancelDownloadButtonText"
                                       Text="Cancel"/>
                        </Button>
                        <Button x:Name="DeleteModelButton" Click="OnDeleteModelClick"
                                AutomationProperties.LabeledBy="{Binding ElementName=DeleteModelButtonText}">
                            <TextBlock x:Uid="LocalInferencePage_DeleteModelButtonText" x:Name="DeleteModelButtonText"
                                       Text="Delete"/>
                        </Button>
                        <TextBlock x:Name="ModelStatusText" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Inline confirmation. Deliberately not a ContentDialog:
                         REACTOR_DIALOG_001 keeps new surfaces off imperative
                         dialogs, and an in-page bar reads better here anyway
                         because the size it is confirming stays on screen. -->
                    <Border x:Name="ConfirmBar"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ConfirmText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ConfirmPrimaryButton" Click="OnConfirmPrimaryClick"
                                        Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.LabeledBy="{Binding ElementName=ConfirmPrimaryButtonText}">
                                    <TextBlock x:Name="ConfirmPrimaryButtonText"/>
                                </Button>
                                <Button x:Name="ConfirmCancelButton" Click="OnConfirmCancelClick"
                                        AutomationProperties.LabeledBy="{Binding ElementName=ConfirmCancelButtonText}">
                                    <TextBlock x:Uid="LocalInferencePage_ConfirmCancelButtonText"
                                               x:Name="ConfirmCancelButtonText" Text="Cancel"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Server -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="LocalInferencePage_ServerHeader" Text="Server"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <ToggleSwitch x:Uid="LocalInferencePage_EnabledToggle" x:Name="EnabledToggle"
                                  Header="Enable local inference"
                                  Toggled="OnEnabledToggled"/>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartButton" Click="OnStartClick"
                                AutomationProperties.LabeledBy="{Binding ElementName=StartButtonText}"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock x:Uid="LocalInferencePage_StartButtonText" x:Name="StartButtonText" Text="Start"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Click="OnStopClick"
                                AutomationProperties.LabeledBy="{Binding ElementName=StopButtonText}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                <TextBlock x:Uid="LocalInferencePage_StopButtonText" x:Name="StopButtonText" Text="Stop"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ServerStatusText" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ProgressRing x:Name="ServerBusyRing" IsActive="False" Width="20" Height="20"
                                  HorizontalAlignment="Left"/>

                    <StackPanel x:Name="EndpointPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Uid="LocalInferencePage_EndpointLabel" Text="OpenAI-compatible endpoint"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="EndpointText" IsReadOnly="True" Width="360"
                                     AutomationProperties.LabeledBy="{Binding ElementName=EndpointText}"/>
                            <Button x:Name="CopyEndpointButton" Click="OnCopyEndpointClick"
                                    AutomationProperties.LabeledBy="{Binding ElementName=CopyEndpointButtonText}">
                                <TextBlock x:Uid="LocalInferencePage_CopyEndpointButtonText" x:Name="CopyEndpointButtonText"
                                           Text="Copy"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="ServerErrorNotice"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA39;" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock x:Name="ServerErrorText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="LocalInferencePage_AdvancedHeader" Text="Advanced"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <ComboBox x:Uid="LocalInferencePage_BackendCombo" x:Name="BackendCombo"
                              Header="Compute backend" SelectionChanged="OnBackendChanged" Width="420"/>

                    <TextBox x:Uid="LocalInferencePage_CustomRuntimeBox" x:Name="CustomRuntimeBox"
                             Header="Custom llama-server build (optional)"
                             PlaceholderText="Path to llama-server.exe or its folder"
                             LostFocus="OnCustomRuntimeChanged" Width="420"/>

                    <Border x:Name="CustomRuntimeNotice"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock x:Uid="LocalInferencePage_CustomRuntimeNoticeText"
                                       Text="A custom build is in use. It is not integrity verified, so only point this at a binary you built or trust."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Uid="LocalInferencePage_AutoStartCheck" x:Name="AutoStartCheck"
                              Content="Start the server when the app starts"
                              Click="OnAutoStartChanged"/>

                    <CheckBox x:Uid="LocalInferencePage_RegisterCheck" x:Name="RegisterCheck"
                              Content="Register this endpoint with the gateway"
                              Click="OnRegisterChanged"/>

                    <CheckBox x:Uid="LocalInferencePage_BindBeyondLoopbackCheck" x:Name="BindBeyondLoopbackCheck"
                              Content="Accept connections from other machines"
                              Click="OnBindBeyondLoopbackChanged"/>
                    <TextBlock x:Uid="LocalInferencePage_BindBeyondLoopbackHelp"
                               Text="Needed when the gateway runs in a WSL distro that cannot reach this machine on localhost. The endpoint has no authentication, so anyone who can reach this port can use the model."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
